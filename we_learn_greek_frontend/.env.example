# Local development — copy to .env
VITE_API_URL=http://localhost:8000/api
# Fall back to bundled demo data when the API is unreachable (local dev only)
VITE_ENABLE_DEMO_DATA=true

# Optional — all features degrade gracefully when these are unset
# Public URL used for canonical + social share tags (Vercel's production domain is used if unset)
# VITE_SITE_URL=https://welearngreek.com
# Public contact address shown on About / Contact / Privacy
# VITE_CONTACT_EMAIL=contact@welearngreek.com
# Form backend accepting JSON POST, e.g. Formspree. Unset = contact form opens the visitor's mail app
# VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
# Donation page (Ko-fi, Open Collective, Stripe Payment Link…). Unset = "Support" links to /support
# VITE_DONATE_URL=https://ko-fi.com/welearngreek
# Cookieless Plausible analytics. Unset = no analytics
# VITE_PLAUSIBLE_DOMAIN=welearngreek.com

# Vercel production (set in Vercel dashboard → Settings → Environment Variables)
# VITE_API_URL=https://we-learn-greek-backend-1.onrender.com/api
# (leave VITE_ENABLE_DEMO_DATA unset — demo data is off unless explicitly "true")
#
# Then add your Vercel URL to backend CORS_ALLOWED_ORIGINS, e.g.:
# CORS_ALLOWED_ORIGINS=https://we-learn-greek.vercel.app
